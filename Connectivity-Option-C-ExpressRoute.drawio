        <!-- ===== DEPLOYMENT STEPS ===== -->
        <mxCell id="steps" value="Deployment Sequence" style="swimlane;startSize=35;fillColor=#f5f5f5;strokeColor=#666;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="800" width="1600" height="120" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="1. Order ER circuit&#xa;from provider&#xa;(2–4 weeks lead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="10" y="40" width="175" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="2. Create ER Gateway&#xa;in CSP VNet&#xa;(~45 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#3A5431;fontColor=#ffffff;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="200" y="40" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="3. Create ER Gateway&#xa;in EA VNet&#xa;(~45 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#3A5431;fontColor=#ffffff;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="375" y="40" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="4. Generate Auth Keys&#xa;from ER circuit&#xa;(one per gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="550" y="40" width="165" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="5. Connect CSP GW&#xa;to ER circuit&#xa;(auth key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E8449;strokeColor=#186A3B;fontColor=#ffffff;fontStyle=1;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="730" y="40" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="6. Connect EA GW&#xa;to ER circuit&#xa;(auth key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E8449;strokeColor=#186A3B;fontColor=#ffffff;fontStyle=1;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="905" y="40" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="7. Configure Private&#xa;Endpoints + DNS&#xa;(both tenants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#ffffff;fontSize=10;" vertex="1" parent="steps">
          <mxGeometry x="1080" y="40" width="160" height="65" as="geometry" />
