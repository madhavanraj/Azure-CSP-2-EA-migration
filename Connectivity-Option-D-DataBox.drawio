<mxfile host="app.diagrams.net" version="21.0">
  <diagram id="OptionD-DataBox" name="Option D - Azure Data Box Connectivity">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;Option D — Azure Data Box (Offline Physical Transfer) Connectivity&lt;/b&gt;&#xa;CSP Tenant → EA Tenant Cross-Tenant Migration" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1480" height="55" as="geometry" />
        </mxCell>

        <!-- SUITABILITY BADGE -->
        <mxCell id="badge" value="Best For: &gt; 40 TB | One-time bulk offline transfer | Slow internet link | Regulated data requiring physical chain-of-custody" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="82" width="1240" height="35" as="geometry" />
        </mxCell>

        <!-- ===== PHASE FLOW HEADER ===== -->
        <mxCell id="phase-hdr" value="Transfer Phases (Physical Flow)" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="128" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- ===== CSP TENANT — PHASE 1: Export ===== -->
        <mxCell id="csp" value="Phase 1: Export Data (CSP Tenant)" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="165" width="420" height="540" as="geometry" />
        </mxCell>

        <mxCell id="csp-sub" value="Azure Portal → Data Box Order" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="csp">
          <mxGeometry x="10" y="48" width="400" height="22" as="geometry" />
        </mxCell>

        <mxCell id="csp-blob" value="Blob Storage&#xa;ADLS Gen2&#xa;Azure Files" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#ffffff;fontSize=11;" vertex="1" parent="csp">
          <mxGeometry x="50" y="80" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="csp-sql" value="SQL Backup&#xa;to Blob first" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#ffffff;fontSize=11;" vertex="1" parent="csp">
          <mxGeometry x="230" y="80" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="csp-order" value="1. Create Data Box Order&#xa;   az databox job create&#xa;   --sku DataBox (80 TB)&#xa;   or DataBoxHeavy (770 TB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="csp">
          <mxGeometry x="20" y="195" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="csp-copy" value="2. Connect device (RJ45 / SFP+)&#xa;3. Copy data:&#xa;   • SMB: \\deviceIP\storageaccount\container&#xa;   • NFS: mount deviceIP:/storageaccount/container&#xa;   • AzCopy: azcopy copy src deviceSMBShare&#xa;4. Validate local checksum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="csp">
          <mxGeometry x="20" y="295" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="csp-encrypt" value="5. Data encrypted at-rest (AES-256)&#xa;   on device before shipping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="csp">
          <mxGeometry x="20" y="430" width="380" height="55" as="geometry" />
        </mxCell>

        <mxCell id="csp-ship-out" value="6. Ship device to Microsoft datacenter&#xa;   (UPS / FedEx with tracking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;" vertex="1" parent="csp">
          <mxGeometry x="20" y="498" width="380" height="55" as="geometry" />
        </mxCell>

        <!-- ===== MICROSOFT DATACENTER — PHASE 2: Ingest ===== -->
        <mxCell id="msdc" value="Phase 2: Microsoft Datacenter Ingest" style="swimlane;startSize=40;fillColor=#f5f5f5;strokeColor=#666;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="165" width="420" height="540" as="geometry" />
        </mxCell>

        <mxCell id="ms-receive" value="📦 Device Received&#xa;at Microsoft Datacenter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="msdc">
          <mxGeometry x="60" y="55" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ms-verify" value="Integrity verification&#xa;Checksum validation against&#xa;manifest generated at source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="msdc">
          <mxGeometry x="60" y="150" width="300" height="65" as="geometry" />
        </mxCell>

        <mxCell id="ms-upload" value="Data uploaded to EA Tenant&#xa;target storage account&#xa;at Microsoft internal speeds&#xa;(10–100 Gbps datacenter links)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="msdc">
          <mxGeometry x="60" y="240" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ms-notify" value="Upload complete notification&#xa;sent via Azure Portal / email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="msdc">
          <mxGeometry x="60" y="345" width="300" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ms-wipe" value="NIST 800-88 secure data wipe&#xa;of device before return / disposal&#xa;Erasure certificate provided" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="msdc">
          <mxGeometry x="60" y="420" width="300" height="65" as="geometry" />
        </mxCell>

        <mxCell id="ms-return" value="Device returned / disposed&#xa;by Microsoft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="msdc">
          <mxGeometry x="60" y="500" width="300" height="45" as="geometry" />
        </mxCell>

        <!-- ===== EA TENANT — PHASE 3: Validate ===== -->
        <mxCell id="ea" value="Phase 3: Validate &amp; Use Data (EA Tenant)" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="165" width="420" height="540" as="geometry" />
        </mxCell>

        <mxCell id="ea-sa" value="Target Storage Account&#xa;(EA Subscription)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#67AB9F;strokeColor=#007A6C;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="ea">
          <mxGeometry x="60" y="55" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ea-blob-tgt" value="Blob Containers" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#006EAF;strokeColor=#004C80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="ea">
          <mxGeometry x="60" y="150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ea-adls-tgt" value="ADLS Gen2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#006EAF;strokeColor=#004C80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="ea">
          <mxGeometry x="230" y="150" width="130" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ea-validate" value="Validate:&#xa;• az storage blob list --query length()&#xa;• Compare counts vs source manifest&#xa;• Spot-check file integrity (MD5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="ea">
          <mxGeometry x="30" y="255" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ea-delta" value="Run AzCopy sync for delta changes&#xa;that occurred during device transit&#xa;(Option A or B for delta only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;align=left;" vertex="1" parent="ea">
          <mxGeometry x="30" y="365" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ea-pe" value="Enable Private Endpoints + Private DNS&#xa;Disable public access on storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#ffffff;fontSize=10;" vertex="1" parent="ea">
          <mxGeometry x="30" y="455" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ea-cutover" value="Cutover: point apps to EA endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E8449;strokeColor=#186A3B;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="ea">
          <mxGeometry x="30" y="528" width="360" height="45" as="geometry" />
        </mxCell>

        <!-- ===== PHYSICAL SHIPPING ARROW ===== -->
        <mxCell id="ship1" value="📦 Ship Device&#xa;(UPS/FedEx)" style="endArrow=block;endFill=1;startArrow=none;strokeColor=#d79b00;strokeWidth=4;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontStyle=1;fontSize=12;" edge="1" parent="1" source="csp" target="msdc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INTERNAL UPLOAD ARROW ===== -->
        <mxCell id="upload1" value="Datacenter&#xa;internal upload" style="endArrow=block;endFill=1;startArrow=none;strokeColor=#82b366;strokeWidth=4;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontSize=12;" edge="1" parent="1" source="msdc" target="ea">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== DATA BOX SKUs ===== -->
        <mxCell id="skus" value="Data Box SKUs" style="swimlane;startSize=35;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="740" width="1600" height="120" as="geometry" />
        </mxCell>

        <mxCell id="sku1" value="Data Box Disk&#xa;8 TB usable (5 disks)&#xa;USB 3.1 / SATA&#xa;Order: 1–5 sets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="skus">
          <mxGeometry x="10" y="40" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sku2" value="Data Box&#xa;80 TB usable&#xa;RJ45 / SFP+&#xa;Best for 40–80 TB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#A07C00;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="skus">
          <mxGeometry x="310" y="40" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sku3" value="Data Box Heavy&#xa;770 TB usable&#xa;SFP28 (40 GbE)&#xa;Best for 500+ TB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8850a;strokeColor=#8B5E00;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="skus">
          <mxGeometry x="610" y="40" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sku4" value="Import Order&#xa;On-premises → Azure&#xa;Supported blob types:&#xa;Block, Page, Append" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" vertex="1" parent="skus">
          <mxGeometry x="910" y="40" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sku5" value="⚠ Not suitable for:&#xa;• Very frequent incremental data&#xa;• Data needing low-latency sync&#xa;• Use with Option A/B for delta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="skus">
          <mxGeometry x="1180" y="40" width="400" height="70" as="geometry" />
        </mxCell>

        <!-- Cost note -->
        <mxCell id="cost" value="Cost: ~$80–$2,000 device fee (per order) + return shipping | No egress charges | Lead time: device arrives in ~5–7 business days | Upload to Azure is FREE" style="text;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="872" width="1600" height="35" as="geometry" />
        </mxCell>

        <!-- Combine with Option A note -->
        <mxCell id="combo" value="Recommended Pattern: Data Box (bulk initial load) + Option A/B (delta sync during transit + post-arrival sync before cutover)" style="text;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="916" width="1600" height="35" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
