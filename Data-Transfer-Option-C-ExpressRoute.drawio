        <mxCell id="m5" value="&lt;b&gt;Structured / ETL Data&lt;/b&gt;&#xa;Tool: ADF + Self-hosted IR&#xa;Port: TCP 443&#xa;Throughput: Configurable parallelism&#xa;Downtime: Zero&#xa;Feature: Transformation + incremental load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="methods">
